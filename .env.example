# Environment Mode
NODE_ENV=production

# Server Configuration
PORT=5001

# CORS Allowed Origins (Comma-separated list for production)
CORS_ORIGINS=https://your-domain.vercel.app,https://your-custom-domain.com

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/lifeos_goals_db?retryWrites=true&w=majority

# Authentication Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# AI Service Integration (Ollama Local / Remote AI Server)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

